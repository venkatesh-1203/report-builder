# ---- Security (REQUIRED) ----
# Any long random string. Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# ---- Reporting currency (ISO 4217 code) ----
CURRENCY_CODE=INR

# ---- Database ----
# Default is a local SQLite file. For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/reports
DATABASE_URL=

# ---- Upload limits ----
MAX_UPLOAD_MB=10
MAX_ROWS=100000
MAX_INVALID_RATIO=0.3
# true = 03/04/2024 means 3 April (India/UK style). false = March 4 (US style)
DATE_DAYFIRST=true

# ---- AI summary (optional). AI_PROVIDER = none | anthropic | gemini ----
AI_PROVIDER=none
AI_API_KEY=
# Leave blank for sensible defaults, or set a model name from your provider
AI_MODEL=

# ---- Scheduled weekly report ----
SCHEDULE_ENABLED=false
SCHEDULE_DAY_OF_WEEK=mon
SCHEDULE_HOUR=9
SCHEDULE_DAYS_BACK=7

# ---- Email delivery (optional) ----
# Required for the dashboard's "Send summary + PDF" action. Use your provider's SMTP settings.
# For Gmail, use smtp.gmail.com:587 and an app password (not your account password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional default recipients for automatically emailed scheduled reports.
REPORT_EMAIL_TO=
